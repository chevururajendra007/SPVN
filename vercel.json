{
  "functions": {
    "api/index.py": {
      "includeFiles": "agent/{*.py,data/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/app/"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/fee-reminders",
      "schedule": "30 3 * * *"
    }
  ]
}

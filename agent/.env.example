# Copy to .env. Default is a free local model through Ollama (no API key).
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Optional, only if LLM_PROVIDER=azure. Never commit real keys.
# AZURE_INFERENCE_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
# AZURE_INFERENCE_CREDENTIAL=<your-api-key>
# AZURE_MODEL_DEPLOYMENT=gpt-4o-mini

LLM_PROVIDER=ollama
# Local runtime on this machine (no internet). Ollama Cloud settings kept below, commented out.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=<your-ollama-cloud-key>   (only for Ollama Cloud; never commit a real key)
OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
# Small model that fits this laptop (4 GB GPU); the on-prem server uses qwen2.5:7b-instruct or vLLM
OLLAMA_MODEL=qwen2.5:3b
